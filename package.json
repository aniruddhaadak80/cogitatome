{
  "name": "cogitatome",
  "version": "0.1.0",
  "private": true,
  "description": "An interpretability observatory and alignment laboratory for the machine mind.",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "generate": "bun scripts/generate-sdk.ts",
    "generate:verify": "bun scripts/generate-sdk.ts --check",
    "seed": "bun scripts/seed.ts",
    "assets": "node scripts/gen-assets.mjs",
    "loc": "node scripts/loc-count.mjs",
    "verify:links": "bun scripts/verify-links.ts",
    "check:induction": "bun scripts/check-induction.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@prisma/client": "^6.16.0",
    "@types/bun": "^1.2.20",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.28",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "prisma": "^6.16.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
