{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional Prisma/SQLite persistence for saved dissections. The app works without it.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "push": "prisma db push --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "@types/node": "^20.19.0"
  }
}
