# Environment — every variable, no secrets
#
# The demo needs NONE of these. Everything runs deterministically with zero API
# keys. Keys and URLs below are only for deployment and for the optional
# polyglot services. Supply real values via {env:...} / {file:...} substitution
# in deployment — never commit them.

# --- Web ---
# Public origin of the deployed app (used for metadata/OG links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: point the UI at a remote Python worker instead of the local stub.
# AGENTS_SERVICE_URL=http://localhost:8000
# Optional: point the UI at a remote Go relay instead of local simulation.
# RELAY_URL=http://localhost:8090

# --- Database (optional) ---
# SQLite by default; switch to Postgres with a connection string for production.
# DATABASE_URL=file:./dev.db

# --- Python worker (services/agents) ---
# CORS_ORIGINS=*            # comma-separated origins; default * for dev
# PORT=8000

# --- Go relay (services/relay) ---
# RELAY_ADDR=:8090
# RELAY_BUFFER_SIZE=4096
# RELAY_SIM_SEED=7
# RELAY_SIM_INTERVAL_MS=250
# RELAY_CORS_ORIGINS=*

# --- Deploy (GitHub Actions; set as repo secrets, never here) ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
